<!--
  Purple Team SOC Lab: eigene Wazuh-Decoder
  Datei auf dem Wazuh-Server: /var/ossec/etc/decoders/local_decoder.xml
  Die Decoder sind mit KI-Unterstützung entstanden und selbst mit wazuh-logtest und live getestet.
-->

<!-- pfSense: erkennt Firewall-Zeilen (filterlog) im Format RFC 5424 -->
<decoder name="pfsense-custom">
  <prematch type="pcre2">^1 \S+ \S+ filterlog \d+ - - </prematch>
</decoder>

<!-- pfSense: zerlegt die kommagetrennten IPv4-Werte in Felder -->
<decoder name="pfsense-custom-ipv4">
  <parent>pfsense-custom</parent>
  <regex type="pcre2" offset="after_parent">^[^,]*,[^,]*,[^,]*,[^,]*,([^,]*),[^,]*,([^,]*),([^,]*),4,(?:[^,]*,){7}([^,]*),[^,]*,([^,]*),([^,]*)(?:,([^,]*),([^,]*))?</regex>
  <order>interface,action,direction,protocol,srcip,dstip,srcport,dstport</order>
</decoder>

<!-- Suricata: erkennt Suricata-Meldungen der pfSense am Syslog-Vorspann -->
<decoder name="suricata-custom">
  <prematch type="pcre2">^1 \S+ \S+ suricata \d+ - - </prematch>
</decoder>

<!-- Suricata: übergibt den JSON-Teil (EVE) an den eingebauten JSON_Decoder -->
<decoder name="suricata-custom-json">
  <parent>suricata-custom</parent>
  <prematch offset="after_parent">^{</prematch>
  <plugin_decoder offset="after_parent">JSON_Decoder</plugin_decoder>
</decoder>
