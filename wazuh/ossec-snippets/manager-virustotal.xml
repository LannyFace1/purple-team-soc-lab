<!--
  Datei: /var/ossec/etc/ossec.conf (innerhalb von <ossec_config>)
  Danach: systemctl restart wazuh-manager
-->

<!-- Bei jedem FIM-Alarm (Gruppe syscheck) wird der Hash der Datei bei VirusTotal geprüft -->
<integration>
  <name>virustotal</name>
  <api_key>VirusTotal_API_KEY</api_key>
  <group>syscheck</group>
  <alert_format>json</alert_format>
</integration>
